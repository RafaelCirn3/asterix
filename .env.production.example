POSTGRES_DB=asterix
POSTGRES_USER=asterix
POSTGRES_PASSWORD=<secret>
PROJECT_NAME=Asterix Consultoria Imobiliaria API
DATABASE_URL=postgresql+psycopg://asterix:<secret>@db:5432/asterix
JWT_SECRET_KEY=<secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
BACKEND_CORS_ORIGINS=https://asterixconsultoria.com.br,https://www.asterixconsultoria.com.br
UPLOAD_DIR=uploads/imoveis
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@asterixconsultoria.com.br
ADMIN_PASSWORD=<secret>

# MCP -> FastAPI interno
INTEGRATION_TOKEN=<generate-a-long-random-token>

# Cliente MCP -> MCP externo. Deve ser diferente de INTEGRATION_TOKEN.
MCP_ACCESS_TOKEN=<generate-another-long-random-token>
