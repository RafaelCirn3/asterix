ENVIRONMENT=development
POSTGRES_DB=asterix
POSTGRES_USER=asterix
POSTGRES_PASSWORD=change-me-locally
PROJECT_NAME=Asterix Consultoria Imobiliaria API
DATABASE_URL=postgresql+psycopg://asterix:change-me-locally@db:5432/asterix
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
UPLOAD_DIR=uploads/imoveis
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@asterix.com.br
ADMIN_PASSWORD=replace-with-a-strong-password
INTEGRATION_TOKEN=replace-with-a-random-integration-token
